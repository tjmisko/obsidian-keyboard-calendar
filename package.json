{
    "name": "obsidian-full-calendar",
    "version": "0.10.7",
    "description": "Obsidian integration with Full Calendar (fullcalendar.io)",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "lint": "prettier --check 'src/**/*.ts*'",
        "fix-lint": "prettier --write 'src/**/*.ts*'",
        "compile": "tsc -noEmit --skipLibCheck",
        "prepare": "husky install",
        "test": "jest --ci --silent=true",
        "test-dev": "jest --watch",
        "coverage": "jest --coverage",
        "benchmark:phase0": "npm run build && OFC_PHASE0_BENCHMARK=1 jest --ci --runInBand --silent=false src/performance/phase0_benchmark.test.ts",
        "benchmark:phase8b": "npm run build && OFC_PHASE8B_BENCHMARK=1 jest --ci --runInBand --silent=false src/performance/phase8b_local_index_benchmark.test.ts"
    },
    "keywords": [],
    "author": {
        "name": "Davis Haupt",
        "email": "contact@davishaupt.com",
        "url": "https://davi.sh"
    },
    "license": "MIT",
    "devDependencies": {
        "@types/jest": "^29.2.3",
        "@types/luxon": "^2.0.9",
        "@types/node": "^16.11.6",
        "@typescript-eslint/eslint-plugin": "^5.2.0",
        "@typescript-eslint/parser": "^5.2.0",
        "builtin-modules": "^3.2.0",
        "esbuild": "0.13.12",
        "fast-check": "^3.8.0",
        "husky": "^7.0.4",
        "jest": "^29.3.1",
        "obsidian": "^0.16.3",
        "prettier": "^2.5.1",
        "ts-jest": "^29.0.3",
        "tslib": "2.3.1",
        "typescript": "4.4.4",
        "zod-fast-check": "^0.9.0"
    },
    "dependencies": {
        "@fullcalendar/core": "^5.10.1",
        "@fullcalendar/daygrid": "^5.10.1",
        "@fullcalendar/interaction": "^5.10.1",
        "@fullcalendar/list": "^5.10.1",
        "@fullcalendar/rrule": "^5.11.2",
        "@fullcalendar/timegrid": "^5.10.1",
        "luxon": "^2.3.0",
        "moment": "^2.29.4",
        "obsidian-daily-notes-interface": "^0.9.4",
        "rrule": "^2.7.2",
        "zod": "^3.21.4"
    }
}
